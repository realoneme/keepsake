# The public address of the site, used for canonical links, the sitemap and social previews.
# On Vercel the production domain is detected automatically; set this once you have a custom domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Booking and album enquiries are emailed through Resend (https://resend.com).
# Without these two, the forms tell visitors to write by email instead.
RESEND_API_KEY=
INQUIRY_TO=hello@example.com
# Optional. A sender on a domain verified in Resend.
INQUIRY_FROM=Keepsake <enquiries@example.com>
